{
  "name": "qup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "db:generate": "pnpm --filter @qup/db generate",
    "db:check": "pnpm --filter @qup/db check",
    "db:migrate": "pnpm --filter @qup/db migrate",
    "db:verify": "pnpm --filter @qup/db verify",
    "db:seed:demo": "pnpm --filter @qup/db seed:demo",
    "admin:create": "pnpm --filter @qup/api run admin:create"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  }
}
