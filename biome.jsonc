{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/migrations", "!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "parser": {
      // NestJS uses parameter decorators (@Inject, @Body, @Res).
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // NEVER re-enable useImportType for the API. Nest resolves constructor
      // dependencies from emitted decorator metadata, which needs each injected
      // class imported as a *value*. The rule's auto-fix rewrites those to
      // `import type`, which erases them: typecheck and build still pass, and
      // the app then fails at startup ("Nest can't resolve dependencies").
      //
      // noStaticOnlyClass: `@Module() class X { static forRoot() }` is Nest's
      // standard dynamic-module pattern, not a namespace-in-a-class.
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    }
  ]
}
