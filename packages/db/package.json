    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.1.13"
  }
