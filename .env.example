# Copy to .env and fill in real values. Never commit .env.

# Cranl hosting API key for this project (Cranl dashboard → API keys)
CRANL_QUP_KEY=cranl_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QUP CranL managed PostgreSQL (remote development database).
# Get the real value from Cranl dashboard → qup-db → Overview → External tab.
DATABASE_URL=postgresql://user:password@host:port/qup_db

# Database for integration tests. Tests always roll back, so the dev database
# is safe to use locally; CI points this at an isolated Postgres.
TEST_DATABASE_URL=postgresql://user:password@host:port/qup_db

# --- API (apps/api) — all optional; defaults shown -------------------------
# NODE_ENV=development          # development | test | production
# HOST=0.0.0.0
# PORT=3000
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
# LOG_PRETTY=false              # true for human-readable local logs
# CORS_ALLOWED_ORIGINS=         # comma-separated; empty = no cross-origin access
# TRUST_PROXY=false             # true only behind a known reverse proxy
# BODY_LIMIT_BYTES=1048576
# API_DOCS_ENABLED=             # defaults to true outside production
# SESSION_TTL_HOURS=720         # absolute session lifetime (max 2160)
# SESSION_COOKIE_SECURE=        # defaults to true in production; needs HTTPS
# RATE_LIMIT_PER_MINUTE=300     # per IP, whole API
# AUTH_RATE_LIMIT_PER_MINUTE=10 # per IP, login + register

# --- Payments: Stream (streampay.sa) ----------------------------------------
# Leave unset to run without online payment (checkout answers 503).
# STREAM_API_KEY is the x-api-key value: base64 of "api-key:api-secret"
#   (Stream dashboard → Settings → API Keys).
# STREAM_WEBHOOK_SECRET is shown when the webhook is registered
#   (Stream dashboard → Settings → Webhooks). Endpoint to register:
#   https://<api-host>/api/v1/payments/webhooks/stream  — payment events.
# STREAM_API_KEY=
# STREAM_WEBHOOK_SECRET=
# STREAM_API_BASE_URL=https://stream-app-service.streampay.sa
# PAYMENT_SUCCESS_URL=https://app.example.com/payment/success
# PAYMENT_FAILURE_URL=https://app.example.com/payment/failure
# CHECKOUT_TTL_MINUTES=60
