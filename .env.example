# Copy to .env and fill in real values. Never commit .env.

# Cranl hosting API key for this project (Cranl dashboard → API keys)
CRANL_QUP_KEY=cranl_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QUP CranL managed PostgreSQL (remote development database).
# Get the real value from Cranl dashboard → qup-db → Overview → External tab.
DATABASE_URL=postgresql://user:password@host:port/qup_db

# Database for integration tests. Tests always roll back, so the dev database
# is safe to use locally; CI points this at an isolated Postgres.
TEST_DATABASE_URL=postgresql://user:password@host:port/qup_db

# --- API (apps/api) — all optional; defaults shown -------------------------
# NODE_ENV=development          # development | test | production
# HOST=0.0.0.0
# PORT=3000
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
# LOG_PRETTY=false              # true for human-readable local logs
# CORS_ALLOWED_ORIGINS=         # comma-separated; empty = no cross-origin access
# TRUST_PROXY=false             # or the number of proxies in front of the API (1 behind CranL); never true
# PROXY_SHARED_SECRET=          # >= 32 chars, same value on the web app; required in production
# BODY_LIMIT_BYTES=1048576
# API_DOCS_ENABLED=             # defaults to true outside production
# SESSION_TTL_HOURS=720         # absolute session lifetime (max 2160)
# SESSION_COOKIE_SECURE=        # defaults to true in production; needs HTTPS
# RATE_LIMIT_PER_MINUTE=300     # per IP, whole API
# AUTH_RATE_LIMIT_PER_MINUTE=10 # per IP, login + register
# AI_RATE_LIMIT_PER_MINUTE=20   # per IP, all AI assistance calls together

# --- AI assistance (AI_INTEGRATION.md) ----------------------------------------
# fake = deterministic test provider (refused in production); disabled = off.
# Defaults: fake outside production, disabled in production. Production uses DeepSeek (OPEN_QUESTIONS.md #17):
#   AI_PROVIDER=deepseek  AI_API_KEY=<key from platform.deepseek.com>
# AI_PROVIDER=                   # fake | disabled | anthropic | grok | openai | deepseek | groq
#                                #   | openrouter | gemini | openai-compatible
# AI_API_KEY=                    # the chosen provider's key (anthropic also reads ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=
# AI_MODEL=                      # anthropic: claude-opus-5-5, deepseek: deepseek-chat; the others require the model id
# AI_BASE_URL=                   # overrides a preset's address; required for openai-compatible
# AI_EFFORT=medium               # anthropic only: low | medium | high
# AI_STUDENT_EXPLANATIONS=true   # subscribers of the exam only; false hides it (OPEN_QUESTIONS.md #18)
# AI_STUDY_CHAT=true             # the study chat, subscribers only; false hides it
# AI_TIMEOUT_MS=                 # per attempt, 100..120000; 15000 for fake, 45000 for a real model
# AI_MAX_ATTEMPTS=2              # 1..5

# --- Payments: Stream (streampay.sa) ----------------------------------------
# Leave unset to run without online payment (checkout answers 503).
# STREAM_API_KEY is the x-api-key value: base64 of "api-key:api-secret"
#   (Stream dashboard → Settings → API Keys).
# STREAM_WEBHOOK_SECRET is shown when the webhook is registered
#   (Stream dashboard → Settings → Webhooks). Endpoint to register:
#   https://<api-host>/api/v1/payments/webhooks/stream  — payment events.
# STREAM_API_KEY=
# STREAM_WEBHOOK_SECRET=
# STREAM_API_BASE_URL=https://stream-app-service.streampay.sa
# PAYMENT_SUCCESS_URL=https://app.example.com/payment/success
# PAYMENT_FAILURE_URL=https://app.example.com/payment/failure
# CHECKOUT_TTL_MINUTES=60

# --- Email: SNDR (sndr.sh) ---------------------------------------------------
# Leave SNDR_API_KEY unset to run without email: one-time codes cannot be requested
# (503 EMAIL_NOT_CONFIGURED); everything else works.
# SNDR_API_KEY is created in the SNDR dashboard (API keys, "send" scope).
# SNDR_FROM must be on a domain verified in SNDR (SPF/DKIM/DMARC), e.g.
#   QUP <no-reply@mail.example.com>
# OTP_SECRET keys the one-time-code hashes: openssl rand -hex 32 (required with the key).
# SNDR_WEBHOOK_SECRET signs delivery events (delivered/bounced/failed); register
#   https://<api-host>/api/v1/email/webhooks/sndr in the SNDR dashboard → Webhooks.
# APP_PUBLIC_URL is the web app's public address, for links inside emails.
# SNDR_API_KEY=
# SNDR_FROM=
# OTP_SECRET=
# SNDR_WEBHOOK_SECRET=
# SNDR_REPLY_TO=
# SNDR_API_BASE_URL=https://api.sndr.sh
# APP_PUBLIC_URL=https://app.example.com

# --- Web app (apps/web) -------------------------------------------------------
# Where the web server reaches the API. Read at run time by the web container
# only; never sent to the browser. Defaults to http://localhost:3000 in dev.
# API_INTERNAL_URL=http://localhost:3000
# PROXY_SHARED_SECRET=          # same value as the API's; required in production (C4)
# WEB_TRUSTED_PROXY_HOPS=1       # proxies in front of the web app that append X-Forwarded-For; 0 when published directly
